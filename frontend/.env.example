# ── Frontend environment (Ashianak) ────────────────────────────────────────
# Copy to .env.local for development. In production, BOTH values must be set
# to the public origins — the fallbacks point at localhost and will break
# the deployed site for visitors.

# Browser-side API base (compile-time inlined into the client bundle).
# Local dev fallback: http://localhost:8000/api/v1
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Server-side target for the /uploads/* rewrite in next.config.ts
# (proxies accommodation images from the FastAPI backend, same-origin).
# Local dev fallback: http://127.0.0.1:8000
# BACKEND_ORIGIN=https://api.example.com
